---
import type { CollectionEntry } from "astro:content";
import StatusBadge from "../components/docs/StatusBadge.astro";
import {
  docsHref,
  docsSectionLabels,
  docsSectionOrder,
} from "../data/docs-navigation";
import "../styles/docs.css";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<"docs">;
  entries: CollectionEntry<"docs">[];
  headings: Heading[];
}

const { entry, entries, headings } = Astro.props;
const sortedEntries = [...entries].sort((left, right) => {
  const sectionDifference =
    docsSectionOrder.indexOf(left.data.section as (typeof docsSectionOrder)[number]) -
    docsSectionOrder.indexOf(right.data.section as (typeof docsSectionOrder)[number]);
  return sectionDifference || left.data.order - right.data.order || left.data.title.localeCompare(right.data.title);
});
const currentIndex = sortedEntries.findIndex(({ id }) => id === entry.id);
const previous = currentIndex > 0 ? sortedEntries[currentIndex - 1] : null;
const next = currentIndex < sortedEntries.length - 1 ? sortedEntries[currentIndex + 1] : null;
const grouped = docsSectionOrder
  .map((section) => ({
    section,
    entries: sortedEntries.filter(({ data }) => data.section === section),
  }))
  .filter(({ entries: sectionEntries }) => sectionEntries.length);
const crumbs = entry.id === "index"
  ? []
  : entry.id.split("/").map((segment, index, parts) => ({
      label: index === parts.length - 1 ? entry.data.title : docsSectionLabels[segment] ?? segment,
      href: index === parts.length - 1 ? null : `/docs/${parts.slice(0, index + 1).join("/")}/`,
    }));
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={entry.data.description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{entry.data.title} · Beacon Decision System</title>
  </head>
  <body>
    <a class="docs-skip" href="#docs-content">Skip to documentation</a>
    <header class="docs-topbar">
      <a class="docs-brand" href="/docs/" aria-label="Beacon Decision System home">
        <img src="/favicon.svg" alt="" width="34" height="34" />
        <span><strong>Beacon</strong><small>Decision System</small></span>
      </a>
      <div class="docs-topbar__actions">
        <button class="docs-search-button" type="button" data-search-open>
          <svg class="docs-search-button__icon" aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <span class="docs-search-button__label">Search</span>
          <kbd>/</kbd>
        </button>
        <a href="/workspace/">Workspace</a>
        <a href="/">Marketing site</a>
        <button class="docs-menu-button" type="button" aria-expanded="false" aria-controls="docs-sidebar">
          Menu
        </button>
      </div>
    </header>

    <div class="docs-shell">
      <aside class="docs-sidebar" id="docs-sidebar" aria-label="Documentation navigation">
        <div class="docs-sidebar__intro">
          <span>Canonical project memory</span>
          <p>Current facts, accepted decisions, target architecture, and reviewable proposals.</p>
        </div>
        <nav>
          {grouped.map(({ section, entries: sectionEntries }) => (
            <section>
              <h2>{docsSectionLabels[section]}</h2>
              <ul>
                {sectionEntries.map((document) => (
                  <li>
                    <a
                      href={docsHref(document.id)}
                      aria-current={document.id === entry.id ? "page" : undefined}
                    >
                      <span>{document.data.title}</span>
                      {document.data.status !== "approved" && (
                        <small>{document.data.status}</small>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </nav>
      </aside>

      <main class="docs-main" id="docs-content">
        {crumbs.length > 0 && (
          <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
            <a href="/docs/">Docs</a>
            {crumbs.map((crumb) => (
              <>
                <span aria-hidden="true">/</span>
                {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
              </>
            ))}
          </nav>
        )}

        <header class="docs-page-header">
          <div class="docs-page-header__meta">
            <span>{docsSectionLabels[entry.data.section] ?? entry.data.section}</span>
            <StatusBadge value={entry.data.status} />
            <StatusBadge value={entry.data.truthState} />
          </div>
          <h1>{entry.data.title}</h1>
          <p>{entry.data.description}</p>
          <dl>
            <div><dt>Owner</dt><dd>{entry.data.owners.join(", ")}</dd></div>
            <div><dt>Last reviewed</dt><dd>{entry.data.lastReviewed}</dd></div>
          </dl>
        </header>

        <div class="docs-mobile-toc">
          {toc.length > 0 && (
            <details>
              <summary>On this page</summary>
              <ol>
                {toc.map((heading) => (
                  <li class:list={{ nested: heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          )}
        </div>

        <article class="docs-prose">
          <slot />
        </article>

        <footer class="docs-page-footer">
          <section>
            <h2>Sources</h2>
            {entry.data.sourceFiles.length ? (
              <ul>{entry.data.sourceFiles.map((source) => <li><code>{source}</code></li>)}</ul>
            ) : (
              <p>No external source is claimed for this navigation or reference page.</p>
            )}
          </section>
          {entry.data.relatedAdrs.length > 0 && (
            <section>
              <h2>Related ADRs</h2>
              <ul>{entry.data.relatedAdrs.map((id) => <li><a href={docsHref(`decisions/${id}`)}>{id}</a></li>)}</ul>
            </section>
          )}
          {entry.data.relatedPages.length > 0 && (
            <section>
              <h2>Related documentation</h2>
              <ul>{entry.data.relatedPages.map((id) => <li><a href={docsHref(id)}>{id}</a></li>)}</ul>
            </section>
          )}
        </footer>

        <nav class="docs-pagination" aria-label="Previous and next documentation">
          {previous ? <a rel="prev" href={docsHref(previous.id)}><span>Previous</span>{previous.data.title}</a> : <span />}
          {next ? <a rel="next" href={docsHref(next.id)}><span>Next</span>{next.data.title}</a> : <span />}
        </nav>
      </main>

      <aside class="docs-toc" aria-label="On this page">
        <span>On this page</span>
        {toc.length ? (
          <ol>
            {toc.map((heading) => (
              <li class:list={{ nested: heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        ) : <p>No subsections.</p>}
      </aside>
    </div>

    <dialog class="docs-search" aria-labelledby="search-title">
      <form method="dialog" class="docs-search__head">
        <label id="search-title" for="docs-search-input">Search the source of truth</label>
        <button type="submit">Close</button>
      </form>
      <input id="docs-search-input" type="search" placeholder="Try “provider fallback” or “human approval”" autocomplete="off" />
      <div class="docs-search__results" aria-live="polite"></div>
    </dialog>

    <script>
      const menu = document.querySelector(".docs-menu-button");
      const sidebar = document.querySelector(".docs-sidebar");
      menu?.addEventListener("click", () => {
        const open = menu.getAttribute("aria-expanded") === "true";
        menu.setAttribute("aria-expanded", String(!open));
        sidebar?.classList.toggle("is-open", !open);
      });

      const dialog = document.querySelector(".docs-search");
      const searchInput = document.querySelector("#docs-search-input");
      const results = document.querySelector(".docs-search__results");
      interface SearchItem {
        href: string;
        title: string;
        description: string;
        searchText: string;
      }
      let index: SearchItem[] = [];
      async function openSearch() {
        if (!(dialog instanceof HTMLDialogElement)) return;
        dialog.showModal();
        if (!index.length) {
          index = await fetch("/search-index.json").then(
            (response) => response.json() as Promise<SearchItem[]>,
          );
        }
        if (searchInput instanceof HTMLInputElement) searchInput.focus();
      }
      document.querySelector("[data-search-open]")?.addEventListener("click", openSearch);
      document.addEventListener("keydown", (event) => {
        if (event.key === "/" && document.activeElement?.tagName !== "INPUT" && document.activeElement?.tagName !== "TEXTAREA") {
          event.preventDefault();
          openSearch();
        }
      });
      searchInput?.addEventListener("input", () => {
        if (!(searchInput instanceof HTMLInputElement) || !(results instanceof HTMLElement)) return;
        const terms = searchInput.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        const matches = terms.length
          ? index.filter((item) => terms.every((term) => item.searchText.includes(term))).slice(0, 12)
          : index.slice(0, 8);
        results.replaceChildren(...matches.map((item) => {
          const link = document.createElement("a");
          link.href = item.href;
          const title = document.createElement("strong");
          title.textContent = item.title;
          const description = document.createElement("span");
          description.textContent = item.description;
          link.appendChild(title);
          link.appendChild(description);
          return link;
        }));
      });

      document.querySelectorAll(".docs-prose pre").forEach((pre) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-code";
        button.textContent = "Copy";
        button.addEventListener("click", async () => {
          await navigator.clipboard.writeText(pre.textContent ?? "");
          button.textContent = "Copied";
          window.setTimeout(() => { button.textContent = "Copy"; }, 1200);
        });
        pre.appendChild(button);
      });
    </script>
  </body>
</html>
