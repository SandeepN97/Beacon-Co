<script>
	function animateCounter(el: HTMLElement, target: number, duration: number) {
		let start: number | null = null;
		const step = (ts: number) => {
			if (!start) start = ts;
			const progress = Math.min((ts - start) / duration, 1);
			const ease = 1 - Math.pow(1 - progress, 3);
			el.textContent = Math.round(ease * target) + "/100";
			if (progress < 1) requestAnimationFrame(step);
		};
		requestAnimationFrame(step);
	}
	const auditFillEl = document.getElementById("auditFill");
	if (auditFillEl && auditFillEl.parentElement) {
		const auditObs = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					if (e.isIntersecting) {
						(auditFillEl as HTMLElement).style.width = "90%";
						const numEl = document.getElementById("auditNum");
						if (numEl) animateCounter(numEl, 90, 1200);
						auditObs.unobserve(e.target);
					}
				});
			},
			{ threshold: 0.5 }
		);
		auditObs.observe(auditFillEl.parentElement);
	}

	const founderCard = document.getElementById("founderCard");
	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	if (founderCard && !prefersReducedMotion) {
		founderCard.addEventListener("mousemove", (e: MouseEvent) => {
			const r = founderCard.getBoundingClientRect();
			const x = (e.clientX - r.left) / r.width - 0.5;
			const y = (e.clientY - r.top) / r.height - 0.5;
			(founderCard as HTMLElement).style.transform =
				`perspective(800px) rotateY(${x * 6}deg) rotateX(${-y * 6}deg) translateY(-2px)`;
			(founderCard as HTMLElement).style.transition = "none";
		});
		founderCard.addEventListener("mouseleave", () => {
			(founderCard as HTMLElement).style.transition =
				"transform .5s cubic-bezier(.16,1,.3,1), box-shadow .3s";
			(founderCard as HTMLElement).style.transform = "";
			setTimeout(() => {
				if (founderCard) (founderCard as HTMLElement).style.transition = "";
			}, 500);
		});
	}
</script>
