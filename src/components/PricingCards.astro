<script>
	const obs = new IntersectionObserver(
		(entries) => {
			entries.forEach((e) => {
				if (e.isIntersecting) {
					const delay = Number((e.target as HTMLElement).dataset.d) || 0;
					setTimeout(() => e.target.classList.add("in"), delay);
					obs.unobserve(e.target);
				}
			});
		},
		{ threshold: 0.1 }
	);
	document.querySelectorAll<HTMLElement>(".pricing-grid .price-col").forEach((el, i) => {
		el.dataset.d = String((i % 4) * 80);
		obs.observe(el);
	});
</script>
