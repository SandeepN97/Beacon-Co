<section class="section" id="contact">
	<div class="s-tag">Get started</div>
	<h2 class="sh">Let's see what you're<br /><em>missing online.</em></h2>
	<div class="contact-cols">
		<div>
			<p
				style="font-size:.9375rem;color:var(--ink-2);line-height:1.82;font-weight:300;margin-bottom:var(--sp-6)"
			>
				Fill this out and I'll personally send you a detailed audit and a demo website concept for
				your business within 24 hours. Completely free. No obligation.
			</p>
			<div class="cr-items">
				<div class="cr-item">
					<div class="cr-icon">⚡</div>
					<div class="cr-text">
						<h4>Audit + demo in 24 hours</h4>
						<p>Real written audit and a custom website concept — like what you saw for Heard above.</p>
					</div>
				</div>
				<div class="cr-item">
					<div class="cr-icon">👤</div>
					<div class="cr-text">
						<h4>You're talking to Minjoon</h4>
						<p>No sales team. No handoffs. I personally handle every inquiry.</p>
					</div>
				</div>
				<div class="cr-item">
					<div class="cr-icon">📍</div>
					<div class="cr-text">
						<h4>Based in Waynesboro</h4>
						<p>I know the Valley, the foot traffic, and your market.</p>
					</div>
				</div>
				<div class="cr-item">
					<div class="cr-icon">🛡️</div>
					<div class="cr-text">
						<h4>Zero risk</h4>
						<p>Audit is free. Demo is free. You only pay when you see real value.</p>
					</div>
				</div>
			</div>
		</div>
		<div class="form-card">
			<form id="contactForm">
				<div class="fg fg-row">
					<div>
						<label class="flabel">Your name</label>
						<input type="text" class="finput" placeholder="Jane Smith" required />
					</div>
					<div>
						<label class="flabel">Business name</label>
						<input type="text" class="finput" placeholder="Smith's Bakery" required />
					</div>
				</div>
				<div class="fg">
					<label class="flabel">Email address</label>
					<input type="email" class="finput" placeholder="jane@smithsbakery.com" required />
				</div>
				<div class="fg">
					<label class="flabel">Phone (optional)</label>
					<input type="tel" class="finput" placeholder="(540) 000-0000" />
				</div>
				<div class="fg">
					<label class="flabel">Type of business</label>
					<select class="fselect finput">
						<option value="" disabled selected>Select your industry</option>
						<option>Restaurant / Food &amp; Beverage</option>
						<option>Retail Shop / Boutique</option>
						<option>Hair / Beauty / Wellness</option>
						<option>Auto Repair / Services</option>
						<option>Professional Services</option>
						<option>Other</option>
					</select>
				</div>
				<div class="fg">
					<label class="flabel">Biggest gap right now</label>
					<select class="fselect finput">
						<option value="" disabled selected>Where do you need most help?</option>
						<option>I don't have a website</option>
						<option>My Google listing is incomplete</option>
						<option>I have no social media presence</option>
						<option>I need more reviews</option>
						<option>All of the above</option>
						<option>Not sure — just audit me</option>
					</select>
				</div>
				<button type="submit" class="fsubmit" id="formBtn">Send — I'll reply within 24 hours →</button>
				<p class="fnote">🔒 Private. Never shared or sold.</p>
			</form>
		</div>
	</div>
</section>

<script>
	// TODO(Phase 1 backend): no submission endpoint exists yet — this only gives UI
	// feedback. Wire to a Cloudflare Pages Function (functions/contact.ts) + Turnstile
	// per docs/architecture.md once backend work starts; don't build that infra now.
	const form = document.getElementById("contactForm");
	if (form) {
		form.addEventListener("submit", (e) => {
			e.preventDefault();
			const btn = document.getElementById("formBtn") as HTMLButtonElement | null;
			if (!btn || btn.disabled) return;
			btn.textContent = "✓ Sent! Minjoon will respond within 24 hours.";
			btn.style.background = "var(--sage)";
			btn.disabled = true;
		});
	}
</script>
