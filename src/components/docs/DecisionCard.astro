---
import StatusBadge from "./StatusBadge.astro";
interface Props {
  number: string;
  status: string;
  href?: string;
}
const { number, status, href } = Astro.props;
const Wrapper = href ? "a" : "div";
---
<Wrapper class="decision-card" href={href}>
  <div class="decision-card__meta">
    <span>{number}</span>
    <StatusBadge value={status} />
  </div>
  <slot />
</Wrapper>
