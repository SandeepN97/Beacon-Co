---
interface Props {
  src: string;
  title: string;
}
const { src, title } = Astro.props;
---

<figure class="mermaid-diagram" data-mermaid-diagram data-source={src}>
  <figcaption>{title}</figcaption>
  <div
    class="mermaid-diagram__render"
    data-mermaid-render
    role="img"
    tabindex="0"
    aria-label={`${title} rendered diagram`}
  >
  </div>
  <details class="mermaid-diagram__source">
    <summary>View Mermaid source</summary>
    <pre aria-label={`${title} textual diagram source`}>Loading reviewable Mermaid source…</pre>
    <a href={src}>Open or download the local Mermaid source</a>
  </details>
</figure>

<script>
  import mermaid from "mermaid";

  mermaid.initialize({
    startOnLoad: false,
    securityLevel: "strict",
    theme: "base",
    themeVariables: {
      primaryColor: "#f5f1e7",
      primaryTextColor: "#1a1712",
      primaryBorderColor: "#2a4228",
      lineColor: "#55754f",
      secondaryColor: "#dcebd8",
      tertiaryColor: "#f4e7c9",
      fontFamily: "DM Sans, system-ui, sans-serif",
    },
  });

  for (const [index, figure] of [
    ...document.querySelectorAll("[data-mermaid-diagram]"),
  ].entries()) {
    if (!(figure instanceof HTMLElement)) continue;
    const sourcePath = figure.dataset.source;
    const pre = figure.querySelector("pre");
    const container = figure.querySelector("[data-mermaid-render]");
    if (!sourcePath || !(pre instanceof HTMLElement) || !(container instanceof HTMLElement))
      continue;
    try {
      const source = await fetch(sourcePath).then((response) => {
        if (!response.ok) throw new Error(`Diagram source returned ${response.status}`);
        return response.text();
      });
      pre.textContent = source;
      const { svg, bindFunctions } = await mermaid.render(
        `mermaid-${index}-${Math.random().toString(16).slice(2)}`,
        source,
      );
      container.innerHTML = svg;
      bindFunctions?.(container);
    } catch (error) {
      pre.textContent = `Diagram could not render. Open the source link below.\n${String(error)}`;
    }
  }
</script>
