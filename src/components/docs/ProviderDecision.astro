---
interface Props {
  provider: string;
  reason: string;
  simulated?: boolean;
}
const { provider, reason, simulated = true } = Astro.props;
---
<section class="provider-decision">
  <div>
    <span>Routing recommendation</span>
    <strong>{provider}</strong>
  </div>
  <p>{reason}</p>
  {simulated && <small>Prompt preview only · no live provider invocation</small>}
</section>
