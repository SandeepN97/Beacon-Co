const renders = [rBefore, rGoogle, rWebsite, rSocial, rReviews, rResults];

/* Skeleton HTML shown while stage content loads */
function skeletonHTML() {
  return `<div class="skel-wrap">
    <div class="skel skel-h"></div>
    <div class="skel skel-line" style="width:90%"></div>
    <div class="skel skel-line" style="width:75%"></div>
    <div class="skel skel-block"></div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:10px">
      <div class="skel skel-sm"></div>
      <div class="skel skel-sm"></div>
      <div class="skel skel-sm"></div>
    </div>
  </div>`;
}

function render() {
  const s = stages[cur];

  /* Progress bar */
  const pb = document.getElementById('progBar');
  if (pb) pb.style.width = ((cur / (stages.length - 1)) * 100) + '%';

  /* Step tabs */
  document.querySelectorAll('.sn-tab').forEach((el, i) => {
    el.classList.toggle('active', i === cur);
    el.classList.toggle('done', i < cur);
  });

  /* Info card — optimistic: update text immediately */
  const card = document.getElementById('stageCard');
  if (card) {
    card.innerHTML = `
      <div class="si-step-label">${s.step}</div>
      <div class="si-title">${s.title}</div>
      <div class="si-desc">${s.desc}</div>
      <div class="si-insight">
        <div class="si-insight-label">${s.insightLabel}</div>
        <div class="si-insight-text">${s.insight}</div>
      </div>`;
  }

  /* Buttons */
  const btnPrev = document.getElementById('btnPrev');
  if (btnPrev) btnPrev.style.display = cur > 0 ? '' : 'none';

  const btnLbl = document.getElementById('btnLbl');
  if (btnLbl) btnLbl.textContent = s.btn;

  const nb = document.getElementById('btnNext');
  if (nb) {
    const isLast = cur === stages.length - 1;
    nb.style.background = isLast ? 'var(--gold-lt)' : '';
    nb.style.color      = isLast ? 'var(--ink)' : '';
    nb.className = 'btn-next-stage' + (isLast ? ' gold-action' : '');
  }

  /* URL bar + badge */
  const ppUrl = document.getElementById('ppUrl');
  if (ppUrl) ppUrl.textContent = s.url;

  const badge = document.getElementById('ppBadge');
  if (badge) {
    badge.className = 'pp-badge ' + s.badgeClass;
    badge.textContent = s.badgeText;
  }

  /* Preview panel — skeleton → content */
  const body = document.getElementById('ppBody');
  if (!body) return;

  /* Step 1: show skeleton immediately (optimistic) */
  body.innerHTML = skeletonHTML();
  body.style.opacity = '1';
  body.style.transform = 'none';
  body.style.transition = 'none';

  /* Step 2: after short delay, swap in real content with slide-in */
  const loadedCur = cur;
  setTimeout(() => {
    if (cur !== loadedCur) return; /* guard against fast clicking */
    body.style.opacity = '0';
    body.style.transform = 'translateX(10px)';
    body.style.transition = 'opacity .28s ease, transform .28s ease';
    setTimeout(() => {
      if (cur !== loadedCur) return;
      body.innerHTML = renders[cur]();
      body.scrollTop = 0;
      requestAnimationFrame(() => {
        body.style.opacity = '1';
        body.style.transform = 'none';
      });
    }, 150);
  }, 180);
}

/* Scroll only if the step nav is out of view — never yank the page */
function ensureDemoVisible() {
  const nav = document.getElementById('stepNav');
  if (!nav) return;
  const r = nav.getBoundingClientRect();
  const navH = 70; /* fixed header height */
  const inView = r.top >= navH && r.top < window.innerHeight * 0.5;
  if (!inView) {
    const y = window.scrollY + r.top - navH - 12;
    window.scrollTo({ top: y, behavior: 'smooth' });
  }
}

function next() {
  const s = stages[cur];
  if (s.btnAction === 'contact') {
    const c = document.getElementById('contact');
    if (c) c.scrollIntoView({ behavior: 'smooth', block: 'start' });
    return;
  }
  if (cur < stages.length - 1) { cur++; render(); ensureDemoVisible(); }
}
function prev() { if (cur > 0) { cur--; render(); ensureDemoVisible(); } }
function goTo(n: number) { if (n === cur) return; cur = n; render(); ensureDemoVisible(); }
function smSwitch(p: number, btn: HTMLElement | null) {
  document.querySelectorAll('.sm-pane').forEach(el => el.classList.remove('sm-pane-active'));
  const pane = document.getElementById('smPane' + p);
  if (pane) pane.classList.add('sm-pane-active');
  document.querySelectorAll('.sm-tab-btn').forEach(el => el.classList.remove('active'));
  if (btn) btn.classList.add('active');
}

render();

const demoWindow = window as Window & typeof globalThis & {
  goTo: typeof goTo;
  next: typeof next;
  prev: typeof prev;
  smSwitch: typeof smSwitch;
};
demoWindow.goTo = goTo;
demoWindow.next = next;
demoWindow.prev = prev;
demoWindow.smSwitch = smSwitch;
</script>
