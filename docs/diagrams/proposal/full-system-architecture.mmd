subgraph FRONT["🖥️ PRESENTATION"]
    direction TB
    DASH["Admin Dashboard<br/>Next.js · Vercel<br/>pipeline · approvals · health"]:::ui
    SITES["Client Sites<br/>Astro static · Cloudflare Pages<br/>unlimited bandwidth"]:::ui
    VSITE["Beacon & Co. site<br/>static · CF Pages + Turnstile"]:::ui
end

subgraph INGRESS["🚪 INGRESS — verified webhooks"]
    direction TB
    WH["Webhook receiver<br/>Supabase Edge Fn<br/>HMAC signature check<br/>idempotency keys"]:::ingress
end

subgraph ASYNC["📦 ASYNC PLATFORM"]
    direction TB
    SCHED["Schedulers<br/>GH Actions cron<br/>weekly · daily · monthly"]:::async
    QUEUE["Job queue<br/>pg-boss on Postgres<br/>retry + backoff"]:::async
    DLQ["Dead-letter queue<br/>failed jobs → alert"]:::async
    SCHED --> QUEUE --> DLQ
end

subgraph SVCS["⚙️ SERVICES — Node/TS workers"]
    direction TB
    LEADS["Lead Engine<br/>fetch → dedupe → audit → score"]:::svc
    OUTR["Outreach<br/>PDF render · sequences<br/>suppression enforcement"]:::svc
    CONTENT["Content<br/>calendar → drafts → publish"]:::svc
    REVSEO["Reviews + SEO<br/>SMS asks · GBP sync · ranks"]:::svc
    REPORTS["Reporting<br/>collect → summarize → PDF"]:::svc
end

subgraph AIL["🤖 AI LAYER"]
    direction TB
    CLAUDE["Claude API<br/>captions · summaries · replies"]:::ai
    PROMPTS["Prompt templates<br/>versioned · per-client<br/>brand-voice profiles"]:::ai
    GUARD["Output guards<br/>length · banned claims<br/>brand-safety lint"]:::ai
    PROMPTS --> CLAUDE --> GUARD
end

subgraph DATA["🗄️ DATA — Supabase"]
    direction TB
    PG[("Postgres + RLS<br/>leads · clients · projects<br/>calendar · posts · metrics<br/>events · suppression_list")]:::data
    STOR[("Storage<br/>brand kits · PDFs · graphics")]:::data
    AUDIT[("audit_log<br/>append-only · who did what")]:::data
    BAK[("Backups<br/>PITR daily · tested restore")]:::data
end

subgraph SEC["🔐 SECURITY"]
    direction TB
    VAULT["Token vault<br/>client OAuth tokens<br/>encrypted · auto-refresh"]:::sec
    SECRETS["Secrets<br/>env per environment<br/>least-privilege API keys"]:::sec
end

