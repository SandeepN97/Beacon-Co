end

subgraph OBS["🔭 OBSERVABILITY"]
    direction TB
    SENTRY["Sentry<br/>errors + traces"]:::obs
    UPTIME["Uptime checks<br/>client sites + dashboard"]:::obs
    COSTS["Cost alarms<br/>API spend caps"]:::obs
end

