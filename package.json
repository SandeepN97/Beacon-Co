{
  "name": "beacon-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run docs:index",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:accessibility": "npm run build && playwright test tests/browser/accessibility.spec.ts",
    "test:responsive": "npm run build && playwright test tests/browser/responsive.spec.ts",
    "typecheck": "astro check",
    "lint": "eslint src scripts tests playwright.config.ts",
    "format:check": "prettier --check src scripts tests security .github *.json *.mjs *.ts",
    "format": "prettier --write src scripts tests security .github *.json *.mjs *.ts",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:dependencies": "node scripts/security/check-dependency-policy.mjs",
    "security:licenses": "node scripts/security/check-licenses.mjs",
    "security:evidence": "node scripts/security/generate-evidence.mjs",
    "ci:pr-policy": "node scripts/ci/validate-pr-policy.mjs",
    "ci:workflows": "node scripts/ci/validate-workflows.mjs",
    "ci:links": "node scripts/ci/check-built-links.mjs",
    "ci:quality": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run docs:build && npm run ci:links",
    "ci:security": "npm run security:secrets && npm run security:dependencies && npm run security:licenses && npm run ci:workflows",
    "docs:index": "node scripts/build-document-index.mjs",
    "docs:generate": "node scripts/generate-markdoc-corpus.mjs && npm run docs:index",
    "docs:inspect": "node scripts/inspect-source-materials.mjs",
    "docs:sources": "node tools/extract-proposal-architecture-sources.mjs",
    "docs:diagrams": "npm run docs:sources && node tools/generate-architecture-diagrams.mjs && node tools/generate-public-diagram-exports.mjs",
    "docs:diagrams:public": "node tools/generate-public-diagram-exports.mjs",
    "docs:serve": "npm run docs:index && astro dev --host 127.0.0.1 --port 8000",
    "docs:validate": "npm run docs:index && node scripts/validate-markdoc.mjs && node scripts/validate-mermaid.mjs",
    "docs:validate-built": "node tools/validate-built-handbook.mjs",
    "docs:build": "npm run docs:validate && astro build",
    "docs:legacy:build": "npm run docs:diagrams && node tools/validate-documentation-assets.mjs && python3 -m mkdocs build --strict && npm run docs:validate-built"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.0.4",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260726.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "excalidraw-animate": "0.7.2",
    "jsdom": "30.0.0",
    "mermaid": "11.16.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0",
    "yaml": "^2.9.0"
  }
}
